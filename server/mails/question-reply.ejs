<!DOCTYPE html>
<html>
  <head>
    <title>SkillStack | New Activity Notification</title>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style type="text/css">
      /* Reset & Base */
      body {
        margin: 0;
        padding: 0;
        min-width: 100%;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background-color: #f3f4f6;
        color: #1f2937;
        -webkit-font-smoothing: antialiased;
      }
      table { border-spacing: 0; margin: 0 auto; }
      img { border: 0; }
      
      /* Layout */
      .container { 
        width: 100%; 
        max-width: 600px; 
        margin: 20px auto; 
        background-color: #ffffff; 
        border-radius: 12px; 
        overflow: hidden; 
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); 
      }
      
      /* Content */
      .header { 
        padding: 48px 40px 32px 40px; 
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        text-align: left; 
      }
      .body { padding: 40px; }
      .footer { 
        padding: 32px 40px; 
        background-color: #f9fafb; 
        text-align: center; 
        font-size: 13px; 
        color: #6b7280; 
        border-top: 1px solid #edf2f7;
      }
      
      /* Typography */
      .brand-logo { 
        font-size: 22px; 
        font-weight: 800; 
        color: #fbbf24; 
        margin-bottom: 12px; 
        letter-spacing: -0.025em;
        text-transform: uppercase;
      }
      h1 { 
        font-size: 24px; 
        font-weight: 700; 
        line-height: 1.2; 
        margin: 0; 
        color: #ffffff; 
      }
      p { font-size: 16px; line-height: 1.6; margin: 0 0 24px 0; color: #4b5563; }
      
      /* Components */
      .reply-card {
        background-color: #f8fafc;
        border-left: 4px solid #fbbf24;
        padding: 24px;
        margin-bottom: 32px;
        border-radius: 8px;
      }
      .question-title { 
        font-weight: 700; 
        color: #1e293b; 
        display: block; 
        margin-bottom: 8px; 
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      
      .button-wrapper { text-align: center; padding: 10px 0 30px 0; }
      .button {
        background-color: #2563eb;
        color: #ffffff !important;
        padding: 16px 32px;
        font-weight: 600;
        text-decoration: none;
        border-radius: 8px;
        display: inline-block;
        box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.2);
      }
      
      .link { color: #2563eb; text-decoration: none; font-weight: 500; }
      
      /* Responsive */
      @media screen and (max-width: 600px) {
        .container { border-radius: 0; margin: 0; }
        .header, .body { padding: 32px 24px; }
      }
    </style>
  </head>
  <body>
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
      <tr>
        <td align="center">
          <div class="container">
            <!-- Header -->
            <div class="header">
              <div class="brand-logo">SKILLSTACK</div>
              <h1>New activity on your post</h1>
            </div>

            <!-- Body -->
            <div class="body">
              <p>Hello <%= name %>,</p>
              <p>Great news! A community member has shared a new perspective on your recent post. Dive back in to see the latest insights.</p>
              
              <div class="reply-card">
                <span class="question-title">Topic: <%= title %></span>
                <p style="margin: 0; font-style: italic; font-size: 15px; color: #334155;">
                  "Check the latest response to see the full contribution..."
                </p>
              </div>

              <!-- <div class="button-wrapper">
                <a href="https://skillstack.com/dashboard" class="button">View Reply & Join Discussion</a>
              </div> -->

              <p style="font-size: 14px; margin-bottom: 0;">
                Keep forging ahead,<br>
                <strong>The SkillStack Team</strong>
              </p>
            </div>

            <!-- Footer -->
            <div class="footer">
              <p style="margin-bottom: 12px;">
                You're receiving this because you're part of the SkillStack learning community.
              </p>
              <p style="margin-top: 24px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.6;">
                &copy; 2026 SkillStack Inc. &bull; Crafting the future of tech.
              </p>
            </div>
          </div>
        </td>
      </tr>
    </table>
  </body>
</html>