<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SkillStack | Account Activation</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f3f4f6;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        color: #1f2937;
        -webkit-font-smoothing: antialiased;
      }
      .container {
        max-width: 600px;
        margin: 40px auto;
        background: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
      }
      .header {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        padding: 48px 40px;
        text-align: left;
      }

      .brand-logo { 
        font-size: 20px; 
        font-weight: 800; 
        color: #fbbf24; 
        margin-bottom: 12px; 
        letter-spacing: -0.025em;
        text-transform: uppercase;
      }

      .header h1 {
        margin: 0;
        font-size: 24px;
        color: #ffffff;
        font-weight: 700;
      }

      .body {
        padding: 40px;
      }

      .body p {
        font-size: 16px;
        line-height: 1.6;
        color: #4b5563;
        margin-bottom: 24px;
      }

      .code-box {
        background: #f8fafc;
        border: 2px solid #e2e8f0;
        padding: 24px;
        text-align: center;
        font-size: 32px;
        font-weight: 800;
        letter-spacing: 6px;
        color: #1e293b;
        margin: 32px 0;
        border-radius: 8px;
        position: relative;
      }

      .code-label {
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        color: #fbbf24;
        letter-spacing: 0.1em;
        margin-bottom: 8px;
        display: block;
      }
      .footer {
        background: #f9fafb;
        padding: 32px;
        font-size: 13px;
        text-align: center;
        color: #6b7280;
        border-top: 1px solid #edf2f7;
      }
      .footer a {
        color: #2563eb;
        text-decoration: none;
        font-weight: 500;
      }

      @media screen and (max-width: 600px) {
        .container { border-radius: 0; margin: 0; }
        .header, .body { padding: 32px 24px; }
      }
    </style>
  </head>

  <body>
    <div class="container">

      <!-- Header -->
      <div class="header">
        <div class="brand-logo">SkillStack</div>
        <h1>Verify your account</h1>
      </div>

      <!-- Body -->
      <div class="body">
        <p>Hi <strong><%= user.name %></strong>,</p>

        <p>
          Welcome to the forge! To finalize your registration and start building your skills, please use the activation code below:
        </p>

        <div class="code-box">
          <span class="code-label">Verification Code</span>
          <%= activationCode %>
        </div>

        <p style="font-size: 14px; color: #64748b;">
          <strong>Security Note:</strong> This code will expire in <strong>5 minutes</strong>. For your security, do not share this code with anyone.
        </p>

        <p style="font-size: 13px; color: #94a3b8; margin-bottom: 0;">
          If you didn’t attempt to create an account on SkillStack, you can safely ignore this email.
        </p>
      </div>

      <!-- Footer -->
      <div class="footer">
        Need assistance? Our support team is here to help.<br>
        <a href="mailto:support@skillstack.com">support@skillstack.com</a>
        <p style="margin-top: 24px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.6;">
          &copy; 2026 SkillStack Inc. &bull; Crafting the future of tech.
        </p>
      </div>

    </div>
  </body>
</html>