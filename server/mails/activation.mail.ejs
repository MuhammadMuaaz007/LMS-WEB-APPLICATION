<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SkillBridge Activation Email</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f4f6f8;
        font-family: Arial, sans-serif;
        color: #333;
      }

      .container {
        max-width: 600px;
        margin: 40px auto;
        background: #ffffff;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      }

      .header {
        background: linear-gradient(135deg, #0070f3, #0059c1);
        padding: 30px;
        text-align: center;
        color: white;
      }

      .header h1 {
        margin: 0;
        font-size: 22px;
      }

      .body {
        padding: 30px;
      }

      .body h2 {
        margin-top: 0;
      }

      .code-box {
        background: #f0f4ff;
        border: 1px dashed #0070f3;
        padding: 15px;
        text-align: center;
        font-size: 22px;
        font-weight: bold;
        letter-spacing: 3px;
        color: #0070f3;
        margin: 20px 0;
        border-radius: 6px;
      }

      .btn {
        display: inline-block;
        margin-top: 20px;
        padding: 12px 25px;
        background: #0070f3;
        color: #fff;
        text-decoration: none;
        border-radius: 6px;
        font-weight: bold;
      }

      .footer {
        background: #f7f7f7;
        padding: 20px;
        font-size: 13px;
        text-align: center;
        color: #666;
      }

      .footer a {
        color: #0070f3;
      }
    </style>
  </head>

  <body>
    <div class="container">

      <!-- Header -->
      <div class="header">
        <h1>Welcome to SkillBridge 🚀</h1>
      </div>

      <!-- Body -->
      <div class="body">
        <p>Hi <strong><%= user.name %></strong>,</p>

        <p>
          Thanks for signing up! To complete your registration, please verify your account using the activation code below:
        </p>

        <div class="code-box">
          <%= activationCode %>
        </div>

        <p>
          This code will expire in <strong>5 minutes</strong>. Please do not share it with anyone.
        </p>

        <p style="font-size: 13px; color: #777;">
          If you didn’t create this account, you can safely ignore this email.
        </p>
      </div>

      <!-- Footer -->
      <div class="footer">
        Need help? Contact us at
        <a href="mailto:support@skillbridge.com">support@skillbridge.com</a>
      </div>

    </div>
  </body>
</html>